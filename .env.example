# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: n8n Webhook URL (if needed for direct integrations)
N8N_WEBHOOK_URL=https://n8n-sef.sef.energy/webhook/

# Authentication
AUTH_SECRET=your-secret-key-for-signing-tokens

# App URL (set automatically by deployment script in production)
# For local development, leave empty to use localhost
# In production, this is set to the Azure Container App's FQDN
# Azure Container Apps does NOT forward X-Forwarded-Host header, so this is required
APP_URL=
